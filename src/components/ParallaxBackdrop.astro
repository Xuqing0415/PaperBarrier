---
/**
 * 多层剪纸的立体感 —— 皮影／灯箱的层叠结构。
 * 第 4 层（最远）0.2x · 第 3 层 0.5x · 正文 1x · 第 1 层（最近）1.6x
 * 最近那层必须 pointer-events: none，否则会挡住点击。
 */
const petals = [
  { left: "6%", top: "12%", size: 40, rot: -14, dur: 30, delay: -2 },
  { left: "82%", top: "22%", size: 30, rot: 22, dur: 24, delay: -8 },
  { left: "16%", top: "68%", size: 26, rot: 8, dur: 34, delay: -14 },
  { left: "70%", top: "76%", size: 36, rot: -30, dur: 27, delay: -5 },
  { left: "44%", top: "40%", size: 22, rot: 44, dur: 38, delay: -20 },
];
---

<div class="backdrop" aria-hidden="true">
  <div class="backdrop__layer backdrop__layer--far" data-parallax data-speed="0.2">
    <svg class="backdrop__clouds" viewBox="0 0 900 500" preserveAspectRatio="xMidYMid slice">
      <g class="backdrop__cloud">
        <path d="M14 64A20 20 0 0 1 12 26A26 26 0 0 1 58 14A30 30 0 0 1 106 22A22 22 0 0 1 108 64Z"></path>
      </g>
      <g class="backdrop__cloud backdrop__cloud--b">
        <path d="M14 64A20 20 0 0 1 12 26A26 26 0 0 1 58 14A30 30 0 0 1 106 22A22 22 0 0 1 108 64Z"></path>
      </g>
      <g class="backdrop__cloud backdrop__cloud--c">
        <path d="M14 64A20 20 0 0 1 12 26A26 26 0 0 1 58 14A30 30 0 0 1 106 22A22 22 0 0 1 108 64Z"></path>
      </g>
    </svg>
  </div>

  <div class="backdrop__layer backdrop__layer--mid" data-parallax data-speed="0.5">
    <svg class="backdrop__lattice">
      <rect width="100%" height="100%" fill="url(#lattice-ice)"></rect>
    </svg>
  </div>

  <div class="backdrop__layer backdrop__layer--near" data-parallax data-speed="1.6">
    {
      petals.map((p, i) => (
        <span
          class="backdrop__petal"
          style={`left:${p.left};top:${p.top};width:${p.size}px;--rot:${p.rot}deg;--dur:${p.dur}s;--delay:${p.delay}s`}
        >
          <svg viewBox="-20 -20 40 40">
            <path
              d={i % 2 === 0
                ? "M0 -17C6.5 -10 7.5 -2 0 8C-7.5 -2 -6.5 -10 0 -17Z"
                : "M-14 -4C-8 -12 0 -13 8 -8L10 3C2 10 -6 10 -12 4Z"}
              fill-rule="evenodd"
            />
          </svg>
        </span>
      ))
    }
  </div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .backdrop__layer {
    position: absolute;
    inset: -18% 0;
    will-change: transform;
  }

  .backdrop__clouds {
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }

  .backdrop__cloud {
    fill: var(--red);
    opacity: 0.05;
    transform: translate(60px, 40px) scale(2.4);
    transform-origin: 60px 40px;
  }

  .backdrop__cloud--b {
    transform: translate(520px, 240px) scale(3.6) rotate(-8deg);
    opacity: 0.045;
  }

  .backdrop__cloud--c {
    transform: translate(240px, 380px) scale(1.8) rotate(6deg);
    opacity: 0.038;
  }

  /* 祖先要 :global()，不然 Astro 的 scope 会让夜间这一组全部失效 */
  :global([data-theme="night"]) .backdrop__cloud {
    fill: var(--glow);
    opacity: 0.05;
  }

  .backdrop__lattice {
    width: 100%;
    height: 100%;
    opacity: 0.16;
  }

  :global([data-theme="night"]) .backdrop__lattice {
    opacity: 0.24;
  }

  .backdrop__petal {
    position: absolute;
    display: block;
    animation: petal-drift var(--dur, 30s) ease-in-out var(--delay, 0s) infinite alternate;
  }

  .backdrop__petal svg {
    width: 100%;
    height: auto;
  }

  .backdrop__petal path {
    fill: var(--red);
    opacity: 0.16;
  }

  :global([data-theme="night"]) .backdrop__petal path {
    fill: var(--glow);
    opacity: 0.2;
  }

  @keyframes petal-drift {
    from {
      transform: translate3d(0, -6vh, 0) rotate(var(--rot, 0deg));
    }
    to {
      transform: translate3d(3vw, 18vh, 0) rotate(calc(var(--rot, 0deg) + 46deg));
    }
  }

  @media (max-width: 720px) {
    /* 移动端减到 2 层 */
    .backdrop__layer--near {
      display: none;
    }

    .backdrop__lattice {
      opacity: 0.1;
    }
  }
</style>
