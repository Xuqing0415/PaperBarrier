---
/**
 * 全局纸纤维噪点
 * 用 feTurbulence 生成一小块可无缝平铺的纹理，转成 data URI 交给 CSS 平铺。
 * 比一张 PNG 省 95% 体积，而且能随主题改变混合模式。
 */
const tile = 220;
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${tile}" height="${tile}"><filter id="n" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.82" numOctaves="4" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="${tile}" height="${tile}" filter="url(#n)"/></svg>`;
const src = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---

<div class="paper-noise" style={`--noise-src:${src}`} aria-hidden="true"></div>
