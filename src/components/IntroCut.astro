---
/**
 * 首屏 —— 一张红纸铺满屏幕，剪刀沿团花轮廓游走，剪开、透光、展开。
 * 图形与首页主视觉同源（同一个 seed），所以「剪出来的那朵」就是后面的主角。
 */
import { paperCut } from "../lib/papercut";

const art = paperCut({
  seed: 7,
  folds: 12,
  style: "rosette",
  rim: "scallop",
  density: 1.02,
  radius: 100,
});

const holes = art.holes.join(" ");
const gid = "pbIntroLight";
---

<section class="intro" id="intro">
  <div class="intro__paper" data-intro="paper" role="presentation"></div>
  <div class="intro__noise" data-intro="noise" role="presentation"></div>

  <svg
    class="intro__art"
    data-intro="art"
    viewBox={art.viewBox}
    preserveAspectRatio="xMidYMid meet"
    role="presentation"
  >
    <defs>
      <radialGradient id={gid} cx="50%" cy="46%" r="60%">
        <stop offset="0%" stop-color="#fff5dc"></stop>
        <stop offset="42%" stop-color="#ffcd84"></stop>
        <stop offset="100%" stop-color="#f5f0e6"></stop>
      </radialGradient>
    </defs>
    <path
      data-intro="holes"
      d={holes}
      fill={`url(#${gid})`}
      fill-rule="evenodd"
      opacity="0"></path>
    <path
      class="intro__cut"
      data-intro="cut"
      d={art.outline}
      fill="none"
      stroke={`url(#${gid})`}
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>

  <canvas class="intro__shards" data-intro="shards" aria-hidden="true"></canvas>

  <div class="intro__tool" data-intro="tool" data-state="idle" aria-hidden="true">
    <svg viewBox="0 0 64 64">
      <g class="intro__arm intro__arm--a">
        <path class="intro__blade" d="M27.4 31.4 21 5.6l3.7-1.4 8.8 27.2Z"></path>
        <path class="intro__shank" d="M30.6 33.4 24.6 47"></path>
        <circle class="intro__ring" cx="24" cy="53" r="5.6"></circle>
      </g>
      <g class="intro__arm intro__arm--b">
        <path class="intro__blade" d="M36.6 31.4 43 5.6l-3.7-1.4-8.8 27.2Z"></path>
        <path class="intro__shank" d="M33.4 33.4 39.4 47"></path>
        <circle class="intro__ring" cx="40" cy="53" r="5.6"></circle>
      </g>
      <circle class="intro__pin" cx="32" cy="32" r="2.5"></circle>
    </svg>
  </div>

  <p class="intro__caption" data-intro="caption">折 · 剪 · 展开 · 透光</p>

  <button class="intro__skip" type="button" data-intro="skip">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 4 6.6 12.4M15 4l2.4 8.4"></path>
      <circle cx="6.4" cy="16.4" r="2.2"></circle>
      <circle cx="17.6" cy="16.4" r="2.2"></circle>
    </svg>
    跳过
  </button>
</section>

<script>
  import { runIntro } from "../scripts/intro";

  const boot = (): void => {
    if (document.getElementById("intro")) runIntro();
  };

  if (document.readyState === "complete" || document.readyState === "interactive") {
    boot();
  } else {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  }
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--paper);
    overflow: hidden;
  }

  /* 铺满屏幕的红纸。从中央摊开 */
  .intro__paper {
    position: absolute;
    inset: 0;
    background: var(--red);
    transform-origin: center;
    clip-path: circle(150% at 50% 50%);
    will-change: transform, clip-path;
  }

  .intro__noise {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background-image: var(--noise-src);
    background-size: 220px 220px;
    mix-blend-mode: multiply;
    /* 噪点只在红纸上可见 */
    filter: contrast(1.1);
  }

  .intro__art {
    position: relative;
    width: min(72vmin, 620px);
    height: auto;
    overflow: visible;
    will-change: transform;
    filter: drop-shadow(0 0 22px rgba(255, 205, 132, 0.35));
  }

  .intro__cut {
    filter: drop-shadow(0 0 7px rgba(255, 245, 220, 0.9));
  }

  .intro__shards {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .intro__tool {
    position: fixed;
    top: 0;
    left: 0;
    width: 62px;
    height: 62px;
    pointer-events: none;
    opacity: 0;
    transform-origin: 32px 5px;
    will-change: transform;
    filter: drop-shadow(1px 4px 6px rgba(0, 0, 0, 0.35));
  }

  .intro__tool svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .intro__arm {
    transform-box: view-box;
    transform-origin: 32px 32px;
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .intro__tool[data-state="hover"] .intro__arm--a {
    transform: rotate(-9deg);
  }

  .intro__tool[data-state="hover"] .intro__arm--b {
    transform: rotate(9deg);
  }

  .intro__tool[data-state="cut"] .intro__arm--a {
    transform: rotate(0.5deg);
  }

  .intro__tool[data-state="cut"] .intro__arm--b {
    transform: rotate(-0.5deg);
  }

  .intro__blade {
    fill: #fff8e7;
    stroke: rgba(26, 22, 20, 0.5);
    stroke-width: 0.5;
  }

  .intro__shank {
    stroke: #2b2320;
    stroke-width: 3.4;
    stroke-linecap: round;
    fill: none;
  }

  .intro__ring {
    fill: none;
    stroke: #2b2320;
    stroke-width: 3.2;
  }

  .intro__pin {
    fill: #e3c964;
  }

  .intro__caption {
    position: absolute;
    bottom: clamp(1.4rem, 5vh, 3rem);
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
    font-family: var(--font-serif);
    font-size: clamp(0.72rem, 1.5vw, 0.88rem);
    letter-spacing: 0.62em;
    text-indent: 0.62em;
    color: rgba(255, 248, 231, 0.62);
    opacity: 0;
    animation: intro-caption 4.2s ease-in-out 0.9s both;
  }

  @keyframes intro-caption {
    0%,
    100% {
      opacity: 0;
    }
    22%,
    74% {
      opacity: 1;
    }
  }

  .intro__skip {
    position: absolute;
    right: clamp(1rem, 3vw, 2.4rem);
    bottom: clamp(1rem, 3vh, 2.2rem);
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.42rem 0.8rem;
    border: 1px solid rgba(255, 248, 231, 0.32);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.14);
    color: rgba(255, 248, 231, 0.86);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background-color var(--t-micro) linear, border-color var(--t-micro) linear,
      transform var(--t-lift) var(--ease-lift);
  }

  .intro__skip:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 248, 231, 0.7);
    transform: translateY(-2px);
  }

  .intro__skip svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  @media (max-width: 720px) {
    .intro__art {
      width: 84vmin;
    }
  }
</style>
