---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PaperCut from "../../components/PaperCut.astro";
import { latticeById } from "../../lib/lattice";
import { paperCut } from "../../lib/papercut";
import { coverImage, galleryImages } from "../../lib/works-images";
import { pageTitle } from "../../config";

export async function getStaticPaths() {
  const works = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: works[(i - 1 + works.length) % works.length]!,
      next: works[(i + 1) % works.length]!,
    },
  }));
}

const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const d = work.data;
const lat = latticeById(d.lattice);
// 有实拍就贴实拍：主图是纯色剪影（跟着昼夜换色），下面再挂一排原色抠图
const photo = coverImage(d.image, `works/${work.id}.md`);
const shots = galleryImages(d.gallery, `works/${work.id}.md`);
// 放大镜是 2.4 倍，得单独挑更大的源，不然镜片里是一团糊
const lensWidths = photo ? [620, 900, 1180, 1300].filter((w) => w <= photo.width) : [];
const art = paperCut({
  seed: d.seed,
  folds: d.folds,
  density: d.density,
  style: d.cut,
  rim: d.rim,
  radius: 100,
});

// 把团花的外轮廓做成 mask —— 镜片边界就是刀的边界
const lensSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${art.viewBox}"><path d="${art.outline}" fill="#fff"/></svg>`;
const lensMask = `url("data:image/svg+xml,${encodeURIComponent(lensSvg)}")`;
---

<Base title={pageTitle(d.title, "作品")} description={d.summary}>
  <article class="detail wrap">
    <nav class="detail__crumb" aria-label="面包屑">
      <a class="link" href="/works">作品</a>
      <span aria-hidden="true">/</span>
      <span>{d.category}</span>
    </nav>

    <header class="detail__head" data-reveal-group>
      <h1 class="detail__title" data-reveal="lift">{d.title}</h1>
      <p class="detail__summary lead" data-reveal="unfold">{d.summary}</p>
      <dl class="detail__facts" data-reveal="unfold">
        <div><dt>年份</dt><dd>{d.year}</dd></div>
        {d.material && <div><dt>材质</dt><dd>{d.material}</dd></div>}
        {
          !photo && (
            <>
              <div><dt>折数</dt><dd>{d.folds} 折</dd></div>
              <div><dt>刀法</dt><dd>{d.cut}</dd></div>
            </>
          )
        }
        <div><dt>窗棂</dt><dd>{lat.name}</dd></div>
      </dl>
    </header>

    <figure class="detail__figure" data-reveal="fold">
      <div class="detail__lamp" aria-hidden="true"></div>
      <div class="detail__lattice" aria-hidden="true">
        <svg><rect width="100%" height="100%" fill={`url(#lattice-${lat.id})`}></rect></svg>
      </div>

      <div
        class:list={["detail__art", photo && "detail__art--photo"]}
        data-detail-art
        style={photo ? `--ar:${photo.width}/${photo.height}` : undefined}
      >
        {photo ? (
          <Image
            class="detail__cut detail__photo"
            src={photo}
            alt={d.imageAlt ?? `${d.title}：剪纸实拍`}
            widths={[420, 620, 900, 1180]}
            sizes="(max-width: 720px) 92vw, 620px"
          />
        ) : (
          <PaperCut
            class="detail__cut"
            seed={d.seed}
            folds={d.folds}
            density={d.density}
            cut={d.cut}
            rim={d.rim}
            label={`${d.title}：${d.folds} 折团花`}
          />
        )}
        <div
          class="detail__lens"
          data-lens
          aria-hidden="true"
          style={`mask-image:${lensMask};-webkit-mask-image:${lensMask};`}
        >
          <div class="detail__lensInner" data-lens-inner>
            {photo ? (
              <Image
                class="detail__lensArt"
                src={photo}
                alt=""
                aria-hidden="true"
                widths={lensWidths.length > 0 ? lensWidths : [photo.width]}
                sizes="1200px"
              />
            ) : (
              <PaperCut
                seed={d.seed}
                folds={d.folds}
                density={d.density}
                cut={d.cut}
                rim={d.rim}
                decorative
              />
            )}
          </div>
          {/* 镜片要看得出来：一层暖光，把「放大」变成「凑到灯前看」 */}
          <div class="detail__lensGlass" aria-hidden="true"></div>
        </div>
      </div>

      <figcaption class="detail__cap">
        <span class="eyebrow">移动鼠标 · 看刀口细节</span>
        <span class="tag">{lat.name}</span>
      </figcaption>
    </figure>

    {
      shots.length > 0 && (
        <section class="detail__shots" data-reveal="unfold" aria-label="原色实拍">
          <p class="eyebrow">实拍 · 原色 —— 没有换过色的那一份</p>
          <div class="detail__shotsGrid">
            {shots.map((shot, i) => (
              <figure class="detail__shot">
                <Image
                  src={shot}
                  alt={`${d.title}：实拍 ${i + 1}`}
                  widths={[320, 560, 840]}
                  sizes="(max-width: 720px) 46vw, 300px"
                />
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div class="detail__body" data-reveal="unfold">
      <Content />
    </div>

    {
      d.tags.length > 0 && (
        <ul class="detail__tags" data-reveal="unfold">
          {d.tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }

    <nav class="detail__nav" aria-label="相邻作品">
      <a class="detail__navItem" href={`/work/${prev.id}`}>
        <span class="eyebrow">上一件</span>
        <b>{prev.data.title}</b>
      </a>
      <a class="detail__navItem detail__navItem--next" href={`/work/${next.id}`}>
        <span class="eyebrow">下一件</span>
        <b>{next.data.title}</b>
      </a>
    </nav>
  </article>
</Base>

<script>
  import { initLens } from "../../scripts/lens";
  import { initHover } from "../../scripts/hover";

  const boot = (): void => {
    initLens();
    initHover();
  };
  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .detail {
    padding-top: clamp(1.6rem, 5vh, 3rem);
  }

  .detail__crumb {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  .detail__head {
    margin-top: clamp(1.4rem, 4vh, 2.4rem);
    max-width: 62ch;
  }

  .detail__title {
    margin: 0 0 0.6rem;
  }

  .detail__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin: 1.8rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--paper-edge);
  }

  .detail__facts div {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .detail__facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--ink-4);
  }

  .detail__facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
  }

  /* ==================== 作品本体 ==================== */
  .detail__figure {
    position: relative;
    display: grid;
    place-items: center;
    margin: clamp(2rem, 6vh, 3.4rem) 0 0;
    padding: clamp(1.6rem, 5vw, 3.4rem);
    border: 1px solid var(--paper-edge);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper-2) 80%, transparent);
    overflow: hidden;
  }

  .detail__lamp {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 48%, var(--glow) 0%, transparent 78%);
    filter: blur(38px);
    opacity: calc(var(--glow-alpha) * 0.8);
    transition: opacity var(--t-theme) var(--ease-soft);
  }

  .detail__lattice {
    position: absolute;
    inset: 0;
    opacity: 0.2;
  }

  .detail__lattice svg {
    width: 100%;
    height: 100%;
  }

  .detail__art {
    position: relative;
    width: min(62vmin, 520px);
    perspective: 1000px;
  }

  .detail__cut {
    width: 100%;
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0)
      rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 620ms var(--ease-lift);
    filter: drop-shadow(0 14px 30px rgba(26, 22, 20, 0.16));
  }

  /* 实拍：舞台的长宽比跟着照片走，放大镜放大时才不会错位 */
  .detail__art--photo {
    width: min(520px, calc(64vmin * var(--ar)));
    aspect-ratio: var(--ar);
  }

  /* 同上：绝对定位，长卷才撑不高舞台 */
  .detail__photo {
    position: absolute;
    inset: 0;
  }

  .detail__photo,
  .detail__lensArt {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 夜里：红纸压暗成剪影，灯从镂空里透出来 */
  /* 祖先要 :global()，否则 Astro 的 scope 会让这条规则永远不生效 */
  :global([data-theme="night"]) .detail__photo {
    filter: brightness(0.44) saturate(0.92) drop-shadow(0 16px 40px rgba(0, 0, 0, 0.6));
  }

  .detail__art.is-live .detail__cut {
    transition-duration: 140ms;
  }

  /* 团花形的放大镜 */
  .detail__lens {
    position: absolute;
    top: 0;
    left: 0;
    width: 190px;
    height: 190px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease-soft);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    filter: drop-shadow(0 8px 20px rgba(26, 22, 20, 0.3));
  }

  .detail__art.is-zooming .detail__lens {
    opacity: 1;
  }

  .detail__lensInner {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  /* 镜片里的一层暖光：没有它，放大后的团花压在团花上是看不出来的 */
  .detail__lensGlass {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 42%,
      rgba(255, 214, 140, 0.15) 0%,
      rgba(255, 236, 205, 0.05) 62%,
      rgba(255, 240, 215, 0.02) 84%,
      rgba(255, 255, 255, 0) 97%
    );
    mix-blend-mode: screen;
  }

  .detail__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    width: 100%;
    margin-top: 1.4rem;
  }

  /* 提示压在窗棂上，别用最浅的那档灰 */
  .detail__cap .eyebrow {
    color: var(--ink-3);
  }

  /* ==================== 实拍 · 原色 ==================== */
  .detail__shots {
    margin-top: clamp(2rem, 6vh, 3.2rem);
  }

  .detail__shotsGrid {
    display: grid;
    /* auto-fit 才有上限：只有一张实拍时，不会只占 1/5 的格子 */
    grid-template-columns: repeat(auto-fit, minmax(180px, 230px));
    justify-content: start;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    margin-top: 0.9rem;
  }

  .detail__shot {
    margin: 0;
    padding: 0.7rem;
    border: 1px solid var(--paper-edge);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper-2) 76%, transparent);
  }

  .detail__shot img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 14px rgba(26, 22, 20, 0.12));
  }

  :global([data-theme="night"]) .detail__shot img {
    filter: brightness(0.5) saturate(0.9) drop-shadow(0 0 14px rgba(255, 183, 77, 0.22));
  }

  /* ==================== 正文 ==================== */
  .detail__body {
    max-width: 62ch;
    margin: clamp(2.2rem, 6vh, 3.6rem) 0 0;
    font-family: var(--font-serif);
    font-size: 1.04rem;
    line-height: 2;
    color: var(--ink-2);
  }

  .detail__body :global(strong) {
    color: var(--red);
  }

  .detail__body :global(code) {
    padding: 0.1em 0.36em;
    border-radius: 2px;
    background: var(--paper-3);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* ==================== 上一件 / 下一件 ==================== */
  .detail__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--paper-edge);
  }

  .detail__navItem {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: border-color var(--t-micro) linear, background-color var(--t-micro) linear;
  }

  .detail__navItem:hover {
    border-color: var(--paper-edge);
    background: color-mix(in srgb, var(--paper-2) 70%, transparent);
  }

  .detail__navItem b {
    font-family: var(--font-brush);
    font-size: 1.3rem;
    font-weight: 400;
  }

  .detail__navItem--next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 720px) {
    .detail__lens {
      display: none;
    }
  }
</style>
